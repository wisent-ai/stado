# Non-secret routing for the authenticated Stado host-health publisher.
# Copy to /etc/stado/host-health.env with owner-root read permissions.
# For local outage mode, replace both origins with authenticated loopback
# endpoints using the ports configured by the local Stado and Skarbiec units.
STADO_HOST_HEALTH_API_URL=https://stado.wisent.com
STADO_HOST_HEALTH_SKARBIEC_URL=https://skarbiec.wisent.com
