# wisent-compute Azure provider activation env.
# Drop a copy at ~/.config/wisent/azure.env on the mac mini coordinator
# OR add these to the LaunchAgent plist EnvironmentVariables block (when
# install_macos_coordinator.sh is refactored under the line cap).
#
# The provider constructor in stado/providers/azure.py raises if
# AZURE_SUBSCRIPTION_ID is empty. Everything else has a default in
# stado/config.py that matches what was provisioned 2026-05-12:
#   RG  = wisent-compute (in eastus)
#   vnets = wisent-compute-vnet-{eastus,westus2,westus3}
#   NSGs  = wisent-compute-nsg-{eastus,westus2,westus3}
# The per-region -{location} suffix is appended automatically by the
# refactored providers/azure_helpers/network.py module.

AZURE_SUBSCRIPTION_ID=9ae7cfa4-93e4-44f6-8f4d-5cea670e22bd
# GCP billing is disabled, so there is no gcp,azure blend left to run: the
# GCS queue, the Pub/Sub alert sink and the GCS release channel all fail.
WC_PROVIDERS=azure
AZURE_RESOURCE_GROUP=wisent-compute
AZURE_LOCATIONS=eastus,westus2,westus3

# Public key for the agent VM cloud-init. Generated at
# ~/.weles/azure_vm_key on the operator workstation 2026-05-12.
# Paste the contents of azure_vm_key.pub here.
AZURE_SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIINBUaUoYAEF2BpuC7poLDvdL1ReWvz8/Su+80tdDQuZ wisent-compute-azure-agent"

# --- Agent VM identity ----------------------------------------------------
# Resource id of the user-assigned managed identity attached to every agent
# VM (providers/azure/mod.rs::vm_body). On the VM there is no service
# principal in env and no az CLI, so IMDS is the only usable link in the
# token chain (azure_token.rs) — with no identity the agent can neither read
# nor write the blob queue (the fleet sits idle) nor delete itself when idle
# (the VM bills forever). Shape:
#   /subscriptions/<sub>/resourceGroups/<rg>/providers/
#     Microsoft.ManagedIdentity/userAssignedIdentities/<name>
# Create it once and grant that ONE identity:
#   * Storage Blob Data Contributor on WC_AZURE_STORAGE_ACCOUNT. That is a
#     data-plane role; plain Contributor does NOT authorize blob access.
#   * Permission to delete VMs in AZURE_RESOURCE_GROUP.
# User-assigned, not system-assigned: one grant covers the whole fleet and
# nothing is orphaned when an agent self-deletes.
AZURE_VM_IDENTITY_ID=

# --- Queue storage --------------------------------------------------------
# WC_AZURE_STORAGE_ACCOUNT has NO default and the backend constructor
# hard-errors when it is empty (queue/azure_blob.rs, AzureBlobBackend::new).
# WC_AZURE_CONTAINER defaults to "wisent-compute", NOT "stado" — set it
# explicitly or the fleet reads an empty container and sees no jobs.
WC_STORAGE_BACKEND=azure
WC_AZURE_STORAGE_ACCOUNT=
WC_AZURE_CONTAINER=stado

# Not used for routing under the azure backend (queue/storage.rs keeps it as
# a label only), but it still leaks into gs:// URIs (machine.rs) and the
# coverage verifier. Keep it matching the container name.
WC_BUCKET=stado

# --- Binary release channel -----------------------------------------------
# Defaults to the GCS bucket, which is dead. Point it at the Azure container
# mirroring releases/stado/** or no agent VM can install itself
# (data/templates/startup_gpu_agent_azure.sh).
# WC_RELEASE_BASE_URL=https://<account>.blob.core.windows.net/stado/releases/stado

# --- Alerting -------------------------------------------------------------
# Silence the dead GCP Pub/Sub channel: it is non-empty by default, so every
# alert pays a failing ADC probe first. Slack/Telegram/SendGrid still work —
# configure at least one or alerting is silently gone.
WC_ALERTS_TOPIC=

# Keep the Vast bridge alive without GCP Secret Manager (providers/vast.rs
# falls back to Secret Manager only when this is unset).
# VAST_API_KEY=
