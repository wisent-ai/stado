  "machine_api": {
    "_comment": "Dedicated verifier for exact machine clients. Every client bearer is bound to finite actions and scheduler targets; no global machine bearer exists.",
    "skarbiec": {
      "url": "https://<control-plane-skarbiec-host>",
      "consumer": "stado-machine-api-verifier",
      "token_file": "~/.stado/stado-machine-api-verifier-skarbiec-token"
    },
    "clients": {
      "echo": {
        "item": "echo-machine-api",
        "actions": ["cancel", "status", "submit"],
        "targets": ["local"]
      },
      "wisent-enterprise": {
        "item": "wisent-enterprise-machine-api",
        "actions": ["cancel", "status", "submit"],
        "targets": ["local"]
      }
    }
  },
  "release_api": {
    "_comment": "Dedicated verifier for authenticated immutable release creation. Its grant exposes exactly the mapped release publisher items. PUT requires if_absent, delete/overwrite fail, and authenticated reads/lists remain inside the product prefix. Public release downloads remain tokenless GET.",
    "skarbiec": {
      "url": "https://<control-plane-skarbiec-host>",
      "consumer": "stado-release-api-verifier",
      "token_file": "~/.stado/stado-release-api-verifier-skarbiec-token"
