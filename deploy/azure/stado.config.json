{
  "_comment": "Fenced Azure-primary deployment template. Replace every <placeholder>, provision dedicated runtime identities, then remove Azure from providers_disabled and add it to providers while AWS and GCP remain fenced. The active authoritative profile is deploy/local/stado.config.json.",

  "providers": [],
  "providers_disabled": ["azure", "aws", "gcp"],
  "_providers_comment": "The enabled-provider set is intentionally empty. Only after Azure identity, networking, quota, object routes, and the scoped agent grant are provisioned, remove Azure from providers_disabled and add it to providers; AWS and GCP remain fenced.",

  "storage": {
    "backend": "azure",
    "azure": {
      "account": "<storage-account>",
      "container": "stado"
    },
    "backup": {
      "_comment": "Cross-provider replica. The coordinator refreshes it after every dispatch tick; product object writes mirror synchronously. Promotion is manual and fenced.",
      "backend": "s3",
      "bucket": "<backup-bucket>",
      "s3": {
        "region": "<backup-region>"
      }
    }
  },

  "azure": {
    "subscription_id": "<subscription-id>",
    "resource_group": "wisent-compute",
    "locations": ["eastus", "westus2", "westus3"],
    "vnet": "wisent-compute-vnet",
    "subnet": "wisent-compute-subnet",
    "nsg": "wisent-compute-nsg",
    "_network_comment": "The provider does NOT create networking. vnet and nsg must already exist per region, named <vnet>-<location> and <nsg>-<location> (providers/azure/network.rs). The subnet is a child of the region vnet so it carries no suffix.",
    "_image_comment": "image_urn is omitted so the built-in default applies: the microsoft-dsvm ubuntu-hpc image, which ships the NVIDIA driver and CUDA preinstalled. Override here only to pin a different publisher:offer:sku:version.",
    "vm_username": "wisent",
    "ssh_public_key": "<contents of ~/.weles/azure_vm_key.pub>",
    "vm_identity_id": "<managed-identity-resource-id>"
  },

  "deployment": {
    "id": "azure-control-plane"
  },

  "dashboard": {
    "_comment": "Keep the Rust listener loopback-only. Caddy terminates TLS and forwards the dedicated software release route plus authenticated product/control routes.",
    "bind": "localhost"
  },

  "backend": {
    "messaging": {
      "skarbiec": {
        "url": "https://<control-plane-skarbiec-host>",
        "consumer": "wisent-backend-business-messaging",
        "token_file": "~/.stado/wisent-backend-business-messaging-skarbiec-token",
        "items": [
          "wisent-backend-apns",
          "wisent-backend-fcm",
          "stado-supabase"
        ]
      }
    },
    "push_skarbiec": {
      "consumer": "stado-backend-push-api-verifier",
      "token_file": "~/.stado/stado-backend-push-api-verifier-skarbiec-token"
    },
    "push_clients": {
      "wisent-app": {
        "item": "wisent-app-push-router",
        "actions": ["register", "send", "status", "unregister"],
        "paths": ["/api/backend/push/inactivity", "/api/backend/push/reachability", "/api/backend/push/register", "/api/backend/push/unregister"]
      },
      "wisent-backend": {
        "item": "wisent-backend-push-router",
        "actions": ["send"],
        "paths": ["/api/backend/push/inactivity"]
      }
    }
  },
  "rate_limit": {
    "skarbiec": {
      "consumer": "stado-rate-limit-api-verifier",
      "token_file": "~/.stado/stado-rate-limit-api-verifier-skarbiec-token"
    },
    "clients": {
      "trading-autonomy": {
        "consumer": "trading-autonomy-rate-limit-client",
        "item": "trading-autonomy-rate-limit-api",
        "namespaces": ["trading-autonomy"],
        "actions": ["consume"]
      }
    }
  },


  "services": {
    "brama": {
      "allowed_models": [
        "wisent-backend/chat/primary",
        "wisent-backend/chat/fallback",
        "wisent-backend/evaluation",
        "wisent-backend/embeddings",
        "wisent-backend/moderation",
        "weles/agent/primary"
      ],
      "model_aliases": {
        "wisent-backend/chat/primary": "qwen/default",
        "wisent-backend/chat/fallback": "qwen/default",
        "wisent-backend/evaluation": "openai/default",
        "wisent-backend/embeddings": "openai/embeddings",
        "wisent-backend/moderation": "openai/moderation",
        "weles/agent/primary": "qwen/default"
      },
      "required_provider_capabilities": ["local-openai", "openai", "qwen"]
    }
  },

  "secrets": {
    "_comment": "Coordinator read-only grant for route-only machine and host-health verification items. Managed-service, product, and release publisher tokens use their dedicated verifiers. Provider credentials stay exclusively in adapter managed identities. Host writers use a distinct stado-host-health-beacon grant. Every path fails closed; no application token belongs in env or this file.",
    "skarbiec": {
      "url": "https://<control-plane-skarbiec-host>",
      "consumer": "stado-control-plane",
      "token_file": "~/.stado/control-plane-skarbiec-token"
    }
  },
