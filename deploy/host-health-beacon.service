[Unit]
Description=Stado authenticated host health beacon (one-shot)

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
EnvironmentFile=/etc/stado/host-health.env
Environment=STADO_HOST_HEALTH_SKARBIEC_CONSUMER=stado-host-health-beacon
Environment=STADO_HOST_HEALTH_SKARBIEC_TOKEN_FILE=/home/ubuntu/.stado/host-health-beacon-skarbiec-token
Environment=STADO_BIN=/home/ubuntu/.stado/bin/stado
ExecStart=/usr/bin/bash /home/ubuntu/wisent-compute-deploy/deploy/host_health_beacon.sh
