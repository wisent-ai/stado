  "machine_api": {
    "_comment": "Dedicated verifier for exact machine clients. Every client bearer is bound to finite actions and scheduler targets; no global machine bearer exists.",
    "skarbiec": {
      "consumer": "stado-machine-api-verifier",
      "token_file": "~/.stado/stado-machine-api-verifier-skarbiec-token"
    },
    "clients": {
      "echo": {
        "item": "echo-machine-api",
        "actions": [
          "cancel",
          "status",
          "submit"
        ],
        "targets": [
          "local"
        ]
      },
      "wisent-enterprise": {
        "item": "wisent-enterprise-machine-api",
        "actions": [
          "cancel",
          "status",
          "submit"
        ],
        "targets": [
          "local"
        ]
      }
    }
  },
  "release_api": {
    "_comment": "Authenticated publishers use a second dedicated verifier grant. PUT is create-only with if_absent, GET/stat/list stay inside the exact product prefix, and delete is forbidden. Public release downloads remain tokenless GET.",
    "skarbiec": {
      "consumer": "stado-release-api-verifier",
      "token_file": "~/.stado/stado-release-api-verifier-skarbiec-token"
    },
    "publishers": {
      "brama": {
        "item": "brama-release-publisher",
        "prefix": "brama/"
      },
      "compute-marketplace": {
        "item": "compute-marketplace-release-publisher",
        "prefix": "compute-marketplace/"
      },
      "image-video-router": {
        "item": "image-video-router-release-publisher",
        "prefix": "image-video-router/"
      },
      "jeden": {
        "item": "jeden-release-publisher",
        "prefix": "jeden/"
      },
      "jeden-desktop": {
        "item": "jeden-desktop-release-publisher",
        "prefix": "jeden-desktop/"
      },
      "oko": {
        "item": "oko-release-publisher",
        "prefix": "oko/"
      },
      "skarbiec": {
        "item": "skarbiec-release-publisher",
        "prefix": "skarbiec/"
      },
      "stado": {
        "item": "stado-release-publisher",
        "prefix": "stado/"
      },
      "trading-autonomy": {
        "item": "trading-autonomy-release-publisher",
        "prefix": "trading-autonomy/"
      },
      "wisent-backend": {
        "item": "wisent-backend-release-publisher",
        "prefix": "wisent-backend/"
      }
    }
  },
  "service_api": {
    "_comment": "Dedicated managed-service verifier. A request resolves its exact service and action before reading only the mapped deployer token; there is no global service bearer or publisher fallback.",
    "skarbiec": {
      "consumer": "stado-service-api-verifier",
      "token_file": "~/.stado/stado-service-api-verifier-skarbiec-token"
    },
    "deployers": {
      "weles": {
        "consumer": "weles-service-deployer",
        "item": "weles-service-deployer",
        "services": [
          "com.wisent.weles-api"
        ],
        "actions": [
          "status",
          "restart"
        ]
      },
      "compute-marketplace": {
        "consumer": "compute-marketplace-service-deployer",
        "item": "compute-marketplace-service-deployer",
        "services": [
          "compute-marketplace-backend",
          "compute-marketplace-frontend"
        ],
        "actions": [
          "status",
          "restart"
        ]
      },
      "wisent-backend": {
        "consumer": "wisent-backend-release-deployer",
        "item": "wisent-backend-release-deployer",
        "services": [
          "wisent-backend"
        ],
        "actions": [
          "status",
          "restart"
        ]
      },
      "image-video-router": {
        "consumer": "image-video-router-release-deployer",
        "item": "image-video-router-release-deployer",
        "services": [
          "image-video-router"
        ],
        "actions": [
          "promote",
          "reconcile"
        ]
      }
    }
  },
  "agent": {
    "_comment": "Dedicated local workload-agent grant. It is never the control-plane grant; jobs can project only the exact item#field allowlist.",
    "skarbiec": {
      "consumer": "stado-local-agent",
      "url": "https://charless-mac-mini.tail6443b3.ts.net:9443",
      "token_file": "~/.stado/local-agent-skarbiec-token",
      "items": [
        "compute-marketplace-agent",
        "jeden-agent-auth",
