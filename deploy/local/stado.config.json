{
  "_comment": "Concrete outage-safe Mac profile. Only the local provider and local storage are active; Azure, AWS and GCP remain explicitly fenced.",
  "providers": [
    "local"
  ],
  "providers_disabled": [
    "azure",
    "aws",
    "gcp"
  ],
  "billing": {
    "_comment": "Azure remains monitored while compute provisioning stays fenced. GCP billing is intentionally detached and is not an active health source.",
    "providers": [
      "azure"
    ]
  },
  "storage": {
    "backend": "local",
    "local": {
      "path": "~/.stado/local-storage"
    },
    "backup": {
      "_comment": "Temporary same-disk mirror/read fallback only. This is not cross-provider disaster recovery and must not replace the fenced Azure-primary plus S3 production profile.",
      "backend": "local",
      "local": {
        "path": "~/.stado/local-backup"
      }
    }
  },
  "dashboard": {
    "_comment": "Loopback-only API for immediate Mac operation. Direct dashboard access is locally trusted; HTTPS-proxied object, machine, and managed-service routes still require their distinct credentials.",
    "bind": "localhost",
    "trust_https_proxy": true
  },
  "deployment": {
    "_comment": "Empty on the loopback-only local control plane. Remote deployments use their registry UUID for RLS binding.",
    "id": ""
  },
  "backend": {
    "messaging": {
      "skarbiec": {
        "consumer": "wisent-backend-business-messaging",
        "token_file": "~/.stado/wisent-backend-business-messaging-skarbiec-token",
        "items": [
          "wisent-backend-apns",
          "wisent-backend-fcm",
          "stado-supabase"
        ]
      }
    }
  },
  "rate_limit": {
    "skarbiec": {
      "consumer": "stado-rate-limit-api-verifier",
      "token_file": "~/.stado/stado-rate-limit-api-verifier-skarbiec-token"
    },
    "clients": {
      "trading-autonomy": {
        "consumer": "trading-autonomy-rate-limit-client",
        "item": "trading-autonomy-rate-limit-api",
        "namespaces": [
          "trading-autonomy"
        ],
        "actions": [
          "consume"
        ]
      }
    }
  },
  "services": {
    "brama": {
      "allowed_models": [
        "best",
        "wisent-backend/chat/primary",
        "wisent-backend/chat/fallback",
        "wisent-backend/evaluation",
        "wisent-backend/embeddings",
        "wisent-backend/moderation",
        "weles/agent/primary"
      ],
      "model_aliases": {
        "wisent-backend/chat/primary": "featherless/TheDrummer/Cydonia-24B-v4.3",
        "wisent-backend/chat/fallback": "featherless/TheDrummer/Cydonia-24B-v4.3",
        "wisent-backend/evaluation": "openai/default",
        "wisent-backend/embeddings": "openai/embeddings",
        "wisent-backend/moderation": "openai/moderation",
        "weles/agent/primary": "featherless/TheDrummer/Cydonia-24B-v4.3",
        "best": "claude-code/claude-opus-4-6"
      },
      "required_provider_capabilities": [
        "featherless",
        "openai"
      ]
    }
  },
  "credentials": {
    "_comment": "Host-channel key reads are control-plane operations and use the same exact field-scoped coordinator grant reconciled from the registry.",
    "admin": {
      "consumer": "stado-control-plane",
      "token_file": "~/.stado/control-plane-skarbiec-token"
    }
  },
  "secrets": {
    "_comment": "Uses the built-in loopback Skarbiec URL; this coordinator grant is distinct from product, release, and service verifiers and may read only route-local machine and host-health verification items. Host writers use the separate stado-host-health-beacon grant and never receive this control-plane grant.",
    "skarbiec": {
      "consumer": "stado-control-plane",
      "token_file": "~/.stado/control-plane-skarbiec-token"
    }
  },
  "integration": {
    "_comment": "Dedicated exact client-token verifier for the fleet-projection boundary. The product-integration domains (content, echo-paid-ads, singularity, people, backend, deployment, onboarding, trading, most) and their client grants moved to the private wisent-integrations service; only the read-only enterprise fleet projection is served here.",
    "skarbiec": {
      "consumer": "stado-integration-api-verifier",
      "token_file": "~/.stado/stado-integration-api-verifier-skarbiec-token"
    },
    "clients": {
      "wisent-enterprise": {
        "item": "wisent-enterprise-integration-api",
        "allowed_actions": [
          "enterprise/jobs.snapshot",
          "enterprise/jobs.timeseries",
          "enterprise/fleet.host-health",
          "enterprise/fleet.registry"
        ]
      }
    }
  },
