{
  "services": [
    {
      "name": "brama",
      "summary": "The authenticated provider-neutral gateway every Wisent model call goes through.",
      "program": "$HOME/.stado/services/brama/current/$STADO_PLATFORM/bin/start-with-skarbiec",
      "args": [],
      "unit": "com.wisent.always-on.brama"
    },
    {
      "name": "weles",
      "summary": "The browser-automation worker for authorized web workflows.",
      "program": "$HOME/.stado/bin/weles-worker",
      "args": []
    },
    {
      "name": "skarbiec",
      "summary": "The credential and authentication vault.",
      "program": "$HOME/.stado/bin/skarbiec",
      "args": [
        "serve",
        "--port",
        "8895"
      ],
      "unit": "com.wisent.always-on.skarbiec",
      "env": {
        "GNUPGHOME": "$HOME/.gnupg",
        "SKARBIEC_AUDIT_FILE": "$HOME/.stado/skarbiec.audit.jsonl",
        "SKARBIEC_VAULT_FILE": "$HOME/.stado/skarbiec.vault.json"
      }
    },
    {
      "name": "stado-control-plane",
      "summary": "The local control plane: queue coordination and placement for this host's fleet.",
      "program": "$HOME/.stado/bin/stado",
      "args": [
        "coordinator"
      ],
      "unit": "com.wisent.compute.service.stado-local-control-plane",
      "env": {
        "HOME": "$HOME",
        "STADO_CONFIG": "$HOME/.config/stado/config.json"
      }
    },
    {
      "name": "stado",
      "summary": "The core object API for registry, queue and release state.",
      "program": "$HOME/.stado/bin/stado",
      "args": [
        "dashboard",
        "--bind",
        "127.0.0.1",
        "--port",
        "8765"
      ],
      "unit": "com.wisent.always-on.stado-object-api",
      "env": {
        "HOME": "$HOME",
        "STADO_CONFIG": "$HOME/.config/stado/config.json",
        "GNUPGHOME": "$HOME/.gnupg",
        "SKARBIEC_VAULT_FILE": "$HOME/.stado/skarbiec.vault.json",
        "WC_OBJECT_SKARBIEC_TOKEN_FILE": "$HOME/.stado/stado-object-api-verifier-skarbiec-token",
        "WC_RELEASE_SKARBIEC_TOKEN_FILE": "$HOME/.stado/stado-release-api-verifier-skarbiec-token",
        "WC_STORAGE_BACKEND": "local",
        "WC_LOCAL_STORAGE_PATH": "$HOME/.stado/local-storage",
        "WC_BACKUP_STORAGE_BACKEND": "local",
        "WC_BACKUP_LOCAL_STORAGE_PATH": "$HOME/.stado/local-backup"
      }
    },
    {
      "name": "oko",
      "summary": "The local Oko autonomy service.",
      "program": "$HOME/.oko/bin/run-autonomy-service",
      "args": []
    },
    {
      "name": "transcript-lake",
      "summary": "Continuously stream local agent transcripts into Transcript Lake.",
      "program": "$HOME/.local/bin/transcript-lake",
      "args": [
        "stream",
        "--json"
      ]
    }
  ]
}
