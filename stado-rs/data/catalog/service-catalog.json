{
  "services": [
    {
      "name": "brama",
      "summary": "The authenticated provider-neutral gateway every Wisent model call goes through.",
      "program": "$HOME/.stado/services/brama/current/$STADO_PLATFORM/bin/start-with-skarbiec",
      "args": [],
      "unit": "com.wisent.always-on.brama"
    },
    {
      "name": "weles",
      "summary": "One Weles process per host serving the API and admission, the resident task dispatcher that executes authorized browser workflows, and the keyword-planner routes.",
      "program": "$HOME/.stado/services/weles-admission/current/$STADO_PLATFORM/weles-api-launcher",
      "args": [],
      "unit": "com.wisent.weles-admission",
      "retired_units": [
        "com.wisent.weles-worker",
        "com.wisent.compute.service.weles-keyword-planner-api",
        "com.wisent.compute.service.com.wisent.always-on.weles",
        "com.wisent.always-on.weles-api",
        "com.wisent.compute.service.weles-api",
        "com.wisent.weles-auto-deploy",
        "com.wisent.compute.service.weles-release-cutover"
      ]
    },
    {
      "name": "skarbiec",
      "summary": "The credential and authentication vault; one process serves the HTTP API, the capability socket every workload redeems through, and replication of every bond the vault pulls.",
      "program": "$HOME/.stado/bin/skarbiec",
      "args": [
        "serve",
        "--port",
        "8895"
      ],
      "unit": "com.wisent.always-on.skarbiec",
      "env": {
        "SKARBIEC_VAULT_FILE": "$HOME/.stado/skarbiec.vault.json",
        "SKARBIEC_CAP_SOCKET": "$HOME/.stado/skarbiec.vault.sock"
      },
      "retired_units": [
        "com.wisent.compute.service.skarbiec-replica-sync",
        "com.wisent.compute.service.skarbiec-control-plane",
        "com.wisent.skarbiec",
        "com.wisent.compute.service.com.wisent.skarbiec-weles"
      ]
    },
    {
      "name": "stado",
      "summary": "The core object API for registry, queue and release state.",
      "program": "$HOME/.stado/services/com.wisent.always-on.stado-object-api/current/$STADO_PLATFORM/stado",
      "args": [
        "dashboard",
        "--bind",
        "127.0.0.1",
        "--port",
        "8765"
      ],
      "unit": "com.wisent.always-on.stado-object-api",
      "env": {
        "WC_STORAGE_BACKEND": "local",
        "WC_LOCAL_STORAGE_PATH": "$HOME/.stado/local-storage"
      }
    },
    {
      "name": "probierz",
      "summary": "The one Probierz process per host, the failure intake that desktop applications post wisent-errors envelopes to; it needs no harness directory.",
      "program": "$HOME/.stado/bin/probierz",
      "args": [
        "intake",
        "serve",
        "--bind",
        "127.0.0.1:9790"
      ],
      "unit": "com.wisent.compute.service.probierz",
      "retired_units": [
        "com.wisent.probierz-intake"
      ]
    },
    {
      "name": "skrzynka",
      "summary": "Skrzynka loopback mail API and scheduled IMAP synchronization; credentials remain in the account's Skarbiec vault.",
      "program": "$HOME/.local/bin/skrzynka",
      "args": [
        "--skarbiec-bin",
        "$HOME/.local/bin/skarbiec",
        "serve",
        "--bind",
        "127.0.0.1:8788"
      ],
      "unit": "com.wisent.always-on.skrzynka",
      "env": {
        "PATH": "$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    {
      "name": "oko",
      "summary": "The one Oko process per host (oko-cli serve) running the autonomy cadence, the transcript index refresher, the task handover loop and the PTY broker.",
      "program": "$HOME/.stado/bin/oko-cli",
      "args": [
        "serve",
        "--autonomy-interval",
        "300",
        "--control-hours",
        "168",
        "--control-interval",
        "300",
        "--control-max",
        "2"
      ],
      "unit": "com.wisent.compute.service.oko-autonomy",
      "retired_units": [
        "ai.wisent.oko.pty-broker",
        "ai.wisent.oko.transcript-index",
        "ai.wisent.oko.tasks-control",
        "com.wisent.compute.service.oko-goal-lifecycle"
      ]
    },
    {
      "name": "transcript-lake",
      "summary": "The one Transcript Lake process per host, continuously streaming local agent transcripts into the lake.",
      "program": "$HOME/.local/bin/transcript-lake",
      "args": [
        "stream",
        "--json"
      ],
      "unit": "com.wisent.compute.service.transcript-lake",
      "retired_units": [
        "com.wisent.transcript-lake-stream"
      ]
    }
  ]
}
