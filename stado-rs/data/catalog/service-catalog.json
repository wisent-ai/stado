{
  "services": [
    {
      "name": "brama",
      "summary": "The authenticated provider-neutral gateway every Wisent model call goes through.",
      "program": "$HOME/.stado/services/brama/current/$STADO_PLATFORM/bin/start-with-skarbiec",
      "args": [],
      "unit": "com.wisent.always-on.brama"
    },
    {
      "name": "weles",
      "summary": "The browser-automation worker for authorized web workflows.",
      "program": "$HOME/.stado/bin/weles-worker",
      "args": []
    },
    {
      "name": "skarbiec",
      "summary": "The credential and authentication vault.",
      "program": "$HOME/.stado/bin/skarbiec",
      "args": [
        "serve",
        "--port",
        "8895"
      ],
      "unit": "com.wisent.always-on.skarbiec",
      "env": {
        "SKARBIEC_VAULT_FILE": "$HOME/.stado/skarbiec.vault.json"
      }
    },
    {
      "name": "stado",
      "summary": "The core object API for registry, queue and release state.",
      "program": "$HOME/.stado/services/com.wisent.always-on.stado-object-api/current/$STADO_PLATFORM/stado",
      "args": [
        "dashboard",
        "--bind",
        "127.0.0.1",
        "--port",
        "8765"
      ],
      "unit": "com.wisent.always-on.stado-object-api",
      "env": {
        "WC_STORAGE_BACKEND": "local",
        "WC_LOCAL_STORAGE_PATH": "$HOME/.stado/local-storage"
      }
    },
    {
      "name": "skrzynka",
      "summary": "Skrzynka loopback mail API and scheduled IMAP synchronization; credentials remain in the account's Skarbiec vault.",
      "program": "$HOME/.local/bin/skrzynka",
      "args": [
        "--skarbiec-bin",
        "$HOME/.local/bin/skarbiec",
        "serve",
        "--bind",
        "127.0.0.1:8788"
      ],
      "unit": "com.wisent.always-on.skrzynka",
      "env": {
        "PATH": "$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    {
      "name": "oko",
      "summary": "The local Oko autonomy service.",
      "program": "$HOME/.oko/bin/run-autonomy-service",
      "args": []
    },
    {
      "name": "transcript-lake",
      "summary": "Continuously stream local agent transcripts into Transcript Lake.",
      "program": "$HOME/.local/bin/transcript-lake",
      "args": [
        "stream",
        "--json"
      ]
    },
    {
      "name": "brama-grant-sync",
      "summary": "Every provider grant the harnesses on this machine hold joins Brama's pool, every quarter hour, so a gateway whose own credentials died is repaired by a machine that is still signed in.",
      "program": "$HOME/.stado/bin/brama",
      "args": [
        "subscription",
        "sync",
        "--gateway-consumer",
        "oko",
        "--bearer-item",
        "brama-desktop-model-router#token",
        "--every",
        "900",
        "--reason",
        "unattended-harness-grant-sweep",
        "--json"
      ],
      "unit": "com.wisent.compute.service.brama-grant-sync",
      "env": {
        "PATH": "$HOME/.local/bin:$HOME/.stado/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  ]
}
