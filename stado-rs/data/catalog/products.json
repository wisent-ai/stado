{
  "schema_version": 2,
  "products": [
    {
      "name": "stado",
      "why": "the fleet's control binary shared by its object API, resolver, coordinator, queue agent and release agent",
      "source": {
        "product": "stado",
        "member": "stado"
      },
      "platforms": [
        "darwin-arm64",
        "linux-amd64"
      ],
      "install": {
        "kind": "program",
        "root": "$HOME/.stado/bin"
      },
      "version": {
        "kind": "program",
        "argument": "--version",
        "shape": "plain"
      },
      "units": [
        {
          "label": "com.wisent.stado.release-agent"
        },
        {
          "label": "com.wisent.always-on.stado-object-api"
        },
        {
          "label": "com.wisent.compute.service.stado-local-control-plane"
        },
        {
          "label": "com.wisent.stado-resolver"
        },
        {
          "label": "com.wisent.compute.service.stado-agent-mini"
        },
        {
          "label": "com.wisent.compute.agent.{target}"
        },
        {
          "label": "stado-agent.service"
        }
      ]
    },
    {
      "name": "skarbiec",
      "why": "the credential service and CLI; the always-on daemon owns fleet secret delivery",
      "source": {
        "product": "skarbiec",
        "member": "skarbiec"
      },
      "platforms": [
        "darwin-arm64",
        "linux-amd64"
      ],
      "install": {
        "kind": "program",
        "root": "$HOME/.stado/bin"
      },
      "version": {
        "kind": "program",
        "argument": "version",
        "shape": "json"
      },
      "units": [
        {
          "label": "com.wisent.always-on.skarbiec",
          "kind": "launchd",
          "path": "/Library/LaunchDaemons/com.wisent.always-on.skarbiec.plist"
        }
      ]
    },
    {
      "name": "weles-worker",
      "why": "the Weles worker runtime; installed as a release tree beside its own host-local recordings and scratch state, and run by a per-user LaunchAgent",
      "source": {
        "product": "weles-worker",
        "member": "payload/weles-worker.tar.gz"
      },
      "platforms": [
        "darwin-arm64"
      ],
      "install": {
        "kind": "tree",
        "root": "$HOME/weles",
        "preserve": [
          "recordings",
          "var",
          ".work"
        ]
      },
      "superseded_roots": [
        "$HOME/.local/share/weles-worker"
      ],
      "version": {
        "kind": "json_file",
        "path": "package.json",
        "pointer": "/version"
      },
      "units": [
        {
          "label": "com.wisent.weles-worker",
          "kind": "launchd",
          "path": "$HOME/Library/LaunchAgents/com.wisent.weles-worker.plist"
        }
      ]
    },
    {
      "name": "jeden",
      "why": "the operator's coding agent CLI; delivered to workstations at the version the fleet declares, so `jeden import` and every later command exist where the operator types them",
      "source": {
        "product": "jeden",
        "member": "bin/jeden"
      },
      "platforms": [
        "darwin-arm64",
        "linux-amd64"
      ],
      "install": {
        "kind": "program",
        "root": "$HOME/.stado/bin"
      },
      "version": {
        "kind": "program",
        "argument": "--version",
        "shape": "plain"
      },
      "units": []
    },
    {
      "name": "brama",
      "why": "the gateway's own CLI; delivered to every machine an operator signs a provider into, because `brama subscription sync` is how a live grant on a workstation repairs a gateway whose credentials all died, and on 2026-09-20 that grant sat here for a day while the fleet served nothing",
      "source": {
        "product": "brama",
        "member": "bin/brama"
      },
      "platforms": [
        "darwin-arm64",
        "linux-amd64"
      ],
      "install": {
        "kind": "program",
        "root": "$HOME/.stado/bin"
      },
      "version": {
        "kind": "program",
        "argument": "version",
        "shape": "json"
      },
      "units": []
    }
  ]
}
