<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wisent.compute.agent.mini-one</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/u/.stado/bin/stado</string>
        <string>agent</string>
        <string>--auto</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/u/.stado/logs/com.wisent.compute.agent.mini-one.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/u/.stado/logs/com.wisent.compute.agent.mini-one.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>WC_SKARBIEC_URL</key>
        <string>https://skarbiec.invalid</string>
        <key>WC_SKARBIEC_CONSUMER</key>
        <string>stado-local-agent</string>
        <key>WC_SKARBIEC_TOKEN_FILE</key>
        <string>/Users/u/.stado/local-agent-skarbiec-token</string>
        <key>WC_PYTHON</key>
        <string>/usr/bin/python</string>
        <key>PATH</key>
        <string>/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
