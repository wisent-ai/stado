#!/bin/sh
set -eu
umask u=rwx,g=,o=
version_file="$HOME/.stado/stado-release-version"
if [ ! -f "$version_file" ]; then
    echo "The pinned Stado release version is missing"
    false
fi
version="$(cat "$version_file")"
archive=
for candidate in "$HOME"/.stado/releases/stado-public-store/"$version"/*/stado-public-store.tar.gz; do
    if [ -f "$candidate" ]; then
        archive=$candidate
    fi
done
if [ -z "$archive" ]; then
    echo "The immutable Stado release store archive is missing"
    false
fi
store_root="$HOME/.stado/local-storage"
mkdir -p "$store_root"
tar -xzf "$archive" -C "$store_root"
if [ ! -d "$store_root/ecosystem/releases" ]; then
    echo "The immutable Stado release store is incomplete"
    false
fi
printf '%s\n' "$store_root"
