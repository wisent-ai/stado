#!/bin/sh
set -eu
service_env="${STADO_AGENT_SERVICE_ENV:-$HOME/.stado/stado-agent.env}"
if [ ! -f "$service_env" ]; then
    echo "The owner-controlled Stado watchdog environment is required"
    false
fi
set -a
. "$service_env"
set +a
: "${WC_HEALTH_INTERVAL_SECONDS:?WC_HEALTH_INTERVAL_SECONDS is required}"
units="com.wisent.compute.service.stado-agent.service com.wisent.compute.service.wisent-backend.service com.wisent.compute.service.brama.service com.wisent.compute.service.cloudflared.service com.wisent.compute.service.stado-watchdog.service"
payload_file="$(mktemp)"
trap 'rm -f "$payload_file"' EXIT HUP INT TERM
while :; do
    reported_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    host="$(hostname -s | tr '[:upper:]' '[:lower:]')"
    disk="$(df -h / | awk '{line=$0} END {if (line != "") print line}')"
    units_json='{}'
    for unit in $units; do
        state="$(systemctl --user is-active "$unit" || true)"
        units_json="$(printf '%s' "$units_json" | jq -c --arg unit "$unit" --arg state "$state" '. + {($unit): {state: $state}}')"
    done
    jq -n \
        --arg host "$host" \
        --arg reported_at "$reported_at" \
        --arg disk "$disk" \
        --argjson units "$units_json" \
        '{host: $host, reported_at: $reported_at, disk: $disk, units: $units}' \
        > "$payload_file"
    "$HOME/.stado/bin/stado-linux" host publish-beacon "$payload_file" || true
    sleep "$WC_HEALTH_INTERVAL_SECONDS"
done
