#!/bin/sh
set -eu
umask u=rwx,g=,o=
source_file="$HOME/.stado/stado-agent-registry.json"
target_dir="$HOME/.stado/local-storage"
if [ ! -f "$source_file" ]; then
    echo "The canonical Stado agent registry snapshot is missing"
    false
fi
mkdir -p "$target_dir"
target_file="$target_dir/registry.json"
temporary_file="$(mktemp "$target_dir/registry.json.XXXXXX")"
trap 'rm -f "$temporary_file"' EXIT HUP INT TERM
cat "$source_file" > "$temporary_file"
chmod u=rw,go= "$temporary_file"
mv "$temporary_file" "$target_file"
trap - EXIT HUP INT TERM
printf '%s\n' "$target_file"
