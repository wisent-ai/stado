#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Arguments: [--if-running] APP.app

Sends SIGTERM through LaunchServices to the running macOS application identified
by the bundle's CFBundleIdentifier, waits until its process has exited, then
launches the supplied updated bundle in the background. Without --if-running, a
stopped app is launched. The wait has no limit: it is registered in the
machine's register of open waits for as long as it lasts, so `stado waits`
names the application this script stands on.
EOF
}

refuse() {
    printf '%s\n' "$*" >/dev/stderr
    false
}

only_if_running=false
app_bundle=
for argument do
    case "$argument" in
        --if-running)
            only_if_running=true
            ;;
        -h|--help)
            usage
            exit
            ;;
        -*)
            usage >/dev/stderr
            refuse "Unknown option: $argument"
            ;;
        *)
            [ -z "$app_bundle" ] || { usage >/dev/stderr; refuse "Unexpected argument after $app_bundle: $argument"; }
            app_bundle=$argument
            ;;
    esac
done

[ -n "$app_bundle" ] || { usage >/dev/stderr; refuse 'Missing APP.app: name the application bundle to restart.'; }
info_plist="$app_bundle/Contents/Info.plist"
[ -d "$app_bundle" ] || refuse "Application bundle not found: $app_bundle"
[ -f "$info_plist" ] || refuse "Info.plist not found: $info_plist"

bundle_id=$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$info_plist")
[ -n "$bundle_id" ] || refuse "CFBundleIdentifier is empty in $info_plist"

running_asn() {
    /usr/bin/lsappinfo find bundleid="$bundle_id"
}

was_running=$(running_asn)
if [ -z "$was_running" ]; then
    if [ "$only_if_running" = true ]; then
        printf 'Not running; skipped %s (%s)\n' "$app_bundle" "$bundle_id"
        exit
    fi
else
    pid=$(/usr/bin/lsappinfo info -only pid "$bundle_id" | /usr/bin/sed -n 's/^"pid"=//p')
    [ -n "$pid" ] || refuse "LaunchServices lists $bundle_id as running ($was_running) but reports no process id for it"
    /usr/bin/lsappinfo kill "$bundle_id" >/dev/null
    registered=$(stado waits open --kind proces --what "$bundle_id (pid $pid) to exit" --where LaunchServices --pid "$$")
    wait_id=$(printf '%s\n' "$registered" | /usr/bin/sed -n '/^registered /{s/^registered //;s/:.*//;p;}')
    [ -n "$wait_id" ] || refuse "stado waits open answered without a wait id: $registered"
    printf '%s\n' "$registered" >/dev/stderr
    /usr/bin/caffeinate -w "$pid"
    stado waits close "$wait_id" >/dev/stderr
fi

/usr/bin/open -g "$app_bundle"
[ -n "$(running_asn)" ] || refuse "open launched $app_bundle, but LaunchServices lists no running $bundle_id"
printf 'Restarted %s (%s)\n' "$app_bundle" "$bundle_id"
