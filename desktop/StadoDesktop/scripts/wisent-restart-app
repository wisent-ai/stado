#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Usage: wisent-restart-app [--if-running] [--timeout SECONDS] APP.app

Sends SIGTERM through LaunchServices to the running macOS application identified
by the bundle's CFBundleIdentifier, waits for it to exit, then launches the
supplied updated bundle in the background. Without --if-running, a stopped app
is launched.
EOF
}

only_if_running=false
timeout=15
while [ "$#" -gt 0 ]; do
    case "$1" in
        --if-running)
            only_if_running=true
            shift
            ;;
        --timeout)
            [ "$#" -ge 2 ] || { printf '%s\n' 'Missing value for --timeout.' >&2; exit 64; }
            timeout=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 64
            ;;
        *)
            break
            ;;
    esac
done

[ "$#" -eq 1 ] || { usage >&2; exit 64; }
app_bundle=$1
info_plist="$app_bundle/Contents/Info.plist"
[ -d "$app_bundle" ] || { printf 'Application bundle not found: %s\n' "$app_bundle" >&2; exit 66; }
[ -f "$info_plist" ] || { printf 'Info.plist not found: %s\n' "$info_plist" >&2; exit 66; }
case "$timeout" in
    ''|*[!0-9]*) printf 'Timeout must be a positive integer: %s\n' "$timeout" >&2; exit 64 ;;
esac
[ "$timeout" -gt 0 ] || { printf '%s\n' 'Timeout must be greater than zero.' >&2; exit 64; }

bundle_id=$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$info_plist")
[ -n "$bundle_id" ] || { printf 'CFBundleIdentifier is empty in %s\n' "$info_plist" >&2; exit 65; }

running_asn() {
    /usr/bin/lsappinfo find bundleid="$bundle_id"
}

was_running=$(running_asn)
if [ -z "$was_running" ]; then
    if [ "$only_if_running" = true ]; then
        printf 'Not running; skipped %s (%s)\n' "$app_bundle" "$bundle_id"
        exit 0
    fi
else
    /usr/bin/lsappinfo kill "$bundle_id" >/dev/null
    deadline=$(( $(/bin/date +%s) + timeout ))
    while [ -n "$(running_asn)" ]; do
        if [ "$(/bin/date +%s)" -ge "$deadline" ]; then
            printf 'Application did not terminate within %ss: %s\n' "$timeout" "$bundle_id" >&2
            exit 75
        fi
        /bin/sleep 0.1
    done
fi

/usr/bin/open -g "$app_bundle"
deadline=$(( $(/bin/date +%s) + timeout ))
while [ -z "$(running_asn)" ]; do
    if [ "$(/bin/date +%s)" -ge "$deadline" ]; then
        printf 'Application did not launch within %ss: %s\n' "$timeout" "$app_bundle" >&2
        exit 75
    fi
    /bin/sleep 0.1
done

printf 'Restarted %s (%s)\n' "$app_bundle" "$bundle_id"
