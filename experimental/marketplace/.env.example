# Exact non-secret runtime configuration
CORS_ORIGINS=https://compute.wisent.com
BACKEND_URL=https://api.compute.wisent.com
STADO_API_URL=https://stado.example.com
STADO_BIN=/usr/local/bin/stado

# Server-only first-use journey control plane
STADO_INTEGRATION_API_URL=https://integration.example.com
STADO_INTEGRATION_TIMEOUT_MS=5000
COMPUTE_MARKETPLACE_STADO_INTEGRATION_TOKEN=replace-with-product-scoped-token

# Backend startup remains fail-closed until an operator provisions the exact
# runtime fields: database_url, supabase_jwt_secret, stripe_secret_key,
# stripe_webhook_secret, and stado_api_token, plus read access to the existing
# raw bearer `compute-marketplace-agent#token`. No unrelated identity or
# ambient environment fallback is accepted.

# Immutable backend/frontend/agent release publication
STADO_PUBLISHER_SKARBIEC_URL=https://skarbiec.example.com
STADO_PUBLISHER_SKARBIEC_TOKEN_FILE=$HOME/.stado/compute-marketplace-release-publisher-skarbiec-token

# Registry-managed backend/frontend restart (distinct from release publication)
STADO_DEPLOYER_SKARBIEC_URL=https://skarbiec.example.com
STADO_DEPLOYER_SKARBIEC_TOKEN_FILE=$HOME/.stado/compute-marketplace-service-deployer-skarbiec-token
STADO_RELEASE_URL=https://stado.example.com/api/release/object?uri=URL_ENCODED_PINNED_STADO_RELEASE_URI
STADO_RELEASE_SHA256=replace-with-release-sha256
STADO_AGENT_BUILDER_IMAGE=registry.example.com/rust-builder@sha256:REPLACE_WITH_DIGEST
STADO_BACKEND_RELEASE_URI=stado://releases/compute-marketplace/backend/sha256/CHECKSUM/image.tar
STADO_BACKEND_RELEASE_SHA256=replace-with-backend-release-sha256
STADO_FRONTEND_RELEASE_URI=stado://releases/compute-marketplace/frontend/sha256/CHECKSUM/image.tar
STADO_FRONTEND_RELEASE_SHA256=replace-with-frontend-release-sha256
STADO_AGENT_RELEASE_URI=stado://releases/compute-marketplace/agent/sha256/CHECKSUM/wisent-agent
STADO_AGENT_RELEASE_SHA256=replace-with-agent-release-sha256


# Exact public values embedded into the immutable frontend release.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anonymous-key
NEXT_PUBLIC_API_URL=https://api.compute.wisent.com
