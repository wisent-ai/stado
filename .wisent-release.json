{
  "schema_version": 1,
  "product": "stado",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "stado-rs/Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[^\"]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "committed-lock-attribution",
          "argv": [
            "cargo", "test", "--locked", "--manifest-path", "stado-rs/product/Cargo.toml",
            "--test", "committed-lock-attribution"
          ],
          "kind": "test"
        }
      ],
      "build": {
        "argv": [
          "bash",
          "deploy/release/build_stado.sh"
        ]
      },
      "test_products": [
        {"product": "oko", "surface": "cli"}
      ],
      "tests": [
        {
          "name": "editor-reclaim",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "space-reclaim", "sourcekit::"
          ]
        },
        {
          "name": "workload-hold-reclaim",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "space-reclaim", "workload_hold::"
          ]
        },
        {
          "name": "probierz-evidence-reclaim",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "space-reclaim-evidence"
          ]
        },
        {
          "name": "service-directory-beside",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "service-directory-beside"
          ]
        },
        {
          "name": "silent-authority",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "host-silence-silent-authority"
          ]
        },
        {
          "name": "wait-journeys",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "wait-held-lock", "--test", "wait-ended-process", "--test", "wait-registered"
          ]
        },
        {
          "name": "change-left-out",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "change-left-out"
          ]
        },
        {
          "name": "refused-dependency",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "host-silence-refused-dependency"
          ]
        },
        {
          "name": "host-processes-memory",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "scheduler", "--", "host_processes_memory::"
          ]
        }
      ],
      "stage": {
        "stado-rs/target/release/stado": "stado"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "committed-lock-attribution",
          "argv": [
            "cargo", "test", "--locked", "--manifest-path", "stado-rs/product/Cargo.toml",
            "--test", "committed-lock-attribution"
          ],
          "kind": "test"
        },
        {
          "name": "workspace-compiles",
          "argv": [
            "cargo", "test", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--workspace", "--no-run"
          ],
          "kind": "test"
        }
      ],
      "build": {
        "argv": [
          "bash",
          "deploy/release/build_stado.sh"
        ]
      },
      "tests": [
        {
          "name": "service-directory-beside",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "service-directory-beside"
          ]
        },
        {
          "name": "wait-journeys",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "wait-held-lock", "--test", "wait-ended-process", "--test", "wait-registered"
          ]
        },
        {
          "name": "refused-dependency",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "host-silence-refused-dependency"
          ]
        },
        {
          "name": "silent-authority",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "host-silence-silent-authority"
          ]
        },
        {
          "name": "host-processes-memory",
          "argv": [
            "cargo", "test", "--release", "--locked", "--manifest-path", "stado-rs/Cargo.toml",
            "--test", "scheduler", "--", "host_processes_memory::"
          ]
        }
      ],
      "stage": {
        "stado-rs/target/release/stado": "stado"
      }
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  },
  "deliveries": [
    {
      "name": "fleet-darwin",
      "platform": "darwin-arm64",
      "argv": [
        "stado",
        "release",
        "local",
        "install",
        "--member",
        "stado"
      ],
      "required": true,
      "secret_env": {},
      "target": { "product": "stado" }
    },
    {
      "name": "fleet-linux",
      "platform": "linux-amd64",
      "argv": [
        "stado",
        "release",
        "local",
        "install",
        "--member",
        "stado"
      ],
      "required": true,
      "secret_env": {},
      "target": { "product": "stado" }
    }
  ]
}
