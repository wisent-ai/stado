{
  "schema_version": 1,
  "product": "stado",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "stado-rs/Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[^\"]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "fmt",
          "argv": ["cargo", "fmt", "--manifest-path", "stado-rs/Cargo.toml", "--all", "--", "--check"]
        },
        {
          "name": "clippy",
          "argv": ["cargo", "clippy", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--all-targets", "--", "-D", "warnings"]
        }
      ],
      "build": {
        "argv": ["cargo", "build", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--bin", "stado"]
      },
      "stage": {
        "stado-rs/target/release/stado": "bin/stado"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "fmt",
          "argv": ["cargo", "fmt", "--manifest-path", "stado-rs/Cargo.toml", "--all", "--", "--check"]
        },
        {
          "name": "clippy",
          "argv": ["cargo", "clippy", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--all-targets", "--", "-D", "warnings"]
        }
      ],
      "build": {
        "argv": ["cargo", "build", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--bin", "stado"]
      },
      "stage": {
        "stado-rs/target/release/stado": "bin/stado"
      }
    }
  },
  "runtime": {
    "binary": "bin/stado",
    "launcher": "bin/stado",
    "config_schema": 1,
    "state_schema": 1,
    "minimum_stado_version": "0.6.1",
    "rollback_compatible_with": ["0.6.1"]
  },
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": true
  }
}
