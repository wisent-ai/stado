{
  "schema_version": 1,
  "product": "stado",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "stado-rs/Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[^\"]+)\"\\s*$"
  },
  "inputs": {
    "skarbiec": {
      "uri": "stado://sources/skarbiec/618c0d4a46be1eab6071bf091844f965651c6669b6803972f557fd8de76d8d06/source.tar.gz",
      "sha256": "618c0d4a46be1eab6071bf091844f965651c6669b6803972f557fd8de76d8d06",
      "mount": "skarbiec"
    }
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--manifest-path",
            "stado-rs/Cargo.toml",
            "--all",
            "--",
            "--check"
          ]
        },
        {
          "name": "source-documentation",
          "argv": ["cargo", "test", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--package", "stado-source-checks", "--test", "documentation"]
        },
        {
          "name": "clippy",
          "argv": [
            "cargo",
            "clippy",
            "--manifest-path",
            "stado-rs/Cargo.toml",
            "--locked",
            "--all-targets",
            "--keep-going",
            "--",
            "-D",
            "warnings"
          ]
        }
      ],
      "build": {
        "argv": [
          "bash",
          "deploy/release/build_stado.sh"
        ]
      },
      "tests": [
        {
          "name": "single-process-runtime",
          "argv": ["cargo", "test", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--test", "resolver", "host_runtime", "--", "--nocapture"]
        },
        {
          "name": "native-resident-identity",
          "argv": ["/bin/sh", "-c", "STADO_TEST_NATIVE_LABEL=com.wisent.always-on.stado-object-api,com.wisent.stado.release-agent,com.wisent.compute.service.stado-release-agent exec \"$HOME/.cargo/bin/cargo\" test --manifest-path stado-rs/Cargo.toml --locked --release --test resolver native_identity -- --ignored --nocapture"]
        },
        {
          "name": "release-newest",
          "argv": ["cargo", "test", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--test", "release_newest"]
        },
        {
          "name": "fleet-expansion-cli",
          "argv": ["cargo", "test", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--test", "fleet_expansion", "--", "--nocapture"]
        }
      ],
      "stage": {
        "stado-rs/target/release/stado": "stado"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--manifest-path",
            "stado-rs/Cargo.toml",
            "--all",
            "--",
            "--check"
          ]
        },
        {
          "name": "source-documentation",
          "argv": ["cargo", "test", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--package", "stado-source-checks", "--test", "documentation"]
        },
        {
          "name": "clippy",
          "argv": [
            "cargo",
            "clippy",
            "--manifest-path",
            "stado-rs/Cargo.toml",
            "--locked",
            "--all-targets",
            "--keep-going",
            "--",
            "-D",
            "warnings"
          ]
        }
      ],
      "build": {
        "argv": [
          "bash",
          "deploy/release/build_stado.sh"
        ]
      },
      "tests": [
        {
          "name": "single-process-runtime",
          "argv": ["cargo", "test", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--test", "resolver", "host_runtime", "--", "--nocapture"]
        },
        {
          "name": "release-newest",
          "argv": ["cargo", "test", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--test", "release_newest"]
        },
        {
          "name": "fleet-expansion-cli",
          "argv": ["cargo", "test", "--manifest-path", "stado-rs/Cargo.toml", "--locked", "--release", "--test", "fleet_expansion", "--", "--nocapture"]
        }
      ],
      "stage": {
        "stado-rs/target/release/stado": "stado"
      }
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  },
  "deliveries": [
    {
      "name": "fleet-macbook",
      "platform": "darwin-arm64",
      "argv": [
        "stado",
        "release",
        "install-local",
        "--member",
        "stado"
      ],
      "required": true,
      "secret_env": {},
      "target": "lukasz-macbook"
    },
    {
      "name": "fleet-mini",
      "platform": "darwin-arm64",
      "argv": [
        "stado",
        "release",
        "install-local",
        "--member",
        "stado"
      ],
      "required": true,
      "secret_env": {},
      "target": "charless-mac-mini"
    },
    {
      "name": "fleet-linux",
      "platform": "linux-amd64",
      "argv": [
        "stado",
        "release",
        "install-local",
        "--member",
        "stado"
      ],
      "required": true,
      "secret_env": {},
      "target": "ubuntu-server-rtx-pro-6000"
    }
  ]
}
