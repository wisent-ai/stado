{
  "schema_version": 1,
  "product": "stado",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "stado-rs/Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[^\"]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--manifest-path",
            "stado-rs/Cargo.toml",
            "--all",
            "--",
            "--check"
          ],
          "kind": "format"
        },
        {
          "name": "fmt-tests-status",
          "argv": ["cargo", "fmt", "--manifest-path", "tests/status/Cargo.toml", "--all", "--", "--check"],
          "kind": "format"
        },
        {
          "name": "fmt-tests-wait",
          "argv": ["cargo", "fmt", "--manifest-path", "tests/wait/Cargo.toml", "--all", "--", "--check"],
          "kind": "format"
        },
        {
          "name": "fmt-tests-storage-vault-consultation",
          "argv": ["cargo", "fmt", "--manifest-path", "tests/storage/vault_consultation/Cargo.toml", "--all", "--", "--check"],
          "kind": "format"
        },
        {
          "name": "fmt-tests-service-directory-authority-read",
          "argv": ["cargo", "fmt", "--manifest-path", "tests/service_directory/authority_read/Cargo.toml", "--all", "--", "--check"],
          "kind": "format"
        },
        {
          "name": "clippy",
          "argv": [
            "cargo",
            "clippy",
            "--manifest-path",
            "stado-rs/Cargo.toml",
            "--locked",
            "--all-targets",
            "--keep-going",
            "--",
            "-D",
            "warnings"
          ],
          "kind": "lint"
        }
      ],
      "build": {
        "argv": [
          "bash",
          "deploy/release/build_stado.sh"
        ]
      },
      "stage": {
        "stado-rs/target/release/stado": "stado"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--manifest-path",
            "stado-rs/Cargo.toml",
            "--all",
            "--",
            "--check"
          ],
          "kind": "format"
        },
        {
          "name": "fmt-tests-status",
          "argv": ["cargo", "fmt", "--manifest-path", "tests/status/Cargo.toml", "--all", "--", "--check"],
          "kind": "format"
        },
        {
          "name": "fmt-tests-wait",
          "argv": ["cargo", "fmt", "--manifest-path", "tests/wait/Cargo.toml", "--all", "--", "--check"],
          "kind": "format"
        },
        {
          "name": "fmt-tests-storage-vault-consultation",
          "argv": ["cargo", "fmt", "--manifest-path", "tests/storage/vault_consultation/Cargo.toml", "--all", "--", "--check"],
          "kind": "format"
        },
        {
          "name": "fmt-tests-service-directory-authority-read",
          "argv": ["cargo", "fmt", "--manifest-path", "tests/service_directory/authority_read/Cargo.toml", "--all", "--", "--check"],
          "kind": "format"
        },
        {
          "name": "clippy",
          "argv": [
            "cargo",
            "clippy",
            "--manifest-path",
            "stado-rs/Cargo.toml",
            "--locked",
            "--all-targets",
            "--keep-going",
            "--",
            "-D",
            "warnings"
          ],
          "kind": "lint"
        }
      ],
      "build": {
        "argv": [
          "bash",
          "deploy/release/build_stado.sh"
        ]
      },
      "stage": {
        "stado-rs/target/release/stado": "stado"
      }
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  },
  "deliveries": [
    {
      "name": "fleet-darwin",
      "platform": "darwin-arm64",
      "argv": [
        "stado",
        "release",
        "install-local",
        "--member",
        "stado"
      ],
      "required": true,
      "secret_env": {},
      "target": { "product": "stado" }
    },
    {
      "name": "fleet-linux",
      "platform": "linux-amd64",
      "argv": [
        "stado",
        "release",
        "install-local",
        "--member",
        "stado"
      ],
      "required": true,
      "secret_env": {},
      "target": { "product": "stado" }
    }
  ]
}
